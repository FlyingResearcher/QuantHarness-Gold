# ============================================================
# 大模型配置示例文件（支持多模型）
# 使用方法：复制为 .env 后填写真实值
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，请勿把真实 Key 提交到仓库
# 优先级：系统环境变量 > .env
#
# 系统有两类模型槽位：
#   agent 槽位：技术指标分析（工具调用）、形态/趋势的工具文本轮次
#   graph 槽位：形态/趋势的视觉识别、最终交易决策
# 两个槽位可分别指定 provider / base_url / model / api_key / temperature，
# 未指定的项自动回落到下方通用 LLM_* 配置。
# ============================================================

# ==================== 通用配置（兜底） ====================

# 服务商标识，可选值：
#   openai / anthropic / qwen / minimax / minimax_cn / gemini / deepseek
LLM_PROVIDER=minimax_cn

# OpenAI 兼容接口的服务地址
#   minimax_cn : https://api.minimaxi.com/v1
#   minimax    : https://api.minimax.io/v1
#   openai     : https://api.openai.com/v1
#   gemini     : https://generativelanguage.googleapis.com/v1beta/openai/
#   deepseek   : https://api.deepseek.com/v1
LLM_BASE_URL=https://api.minimaxi.com/v1

# 模型名称（两个槽位默认共用）
LLM_MODEL=MiniMax-M3.1-Flash

# API Key（必填；两个槽位默认共用）
LLM_API_KEY=your-api-key-here

# 采样温度，默认 0.1
LLM_TEMPERATURE=0.1

# ==================== agent 槽位（分析/工具） ====================
# 不填则继承上方通用配置
# LLM_AGENT_PROVIDER=minimax_cn
# LLM_AGENT_BASE_URL=https://api.minimaxi.com/v1
# LLM_AGENT_MODEL=MiniMax-M3.1-Flash
# LLM_AGENT_API_KEY=your-api-key-here
# LLM_AGENT_TEMPERATURE=0.1

# ==================== graph 槽位（视觉/决策） ====================
# 不填则继承上方通用配置。示例：分析用文本模型，视觉用多模态模型
# LLM_GRAPH_PROVIDER=qwen
# LLM_GRAPH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_GRAPH_MODEL=qwen-vl-max-latest
# LLM_GRAPH_API_KEY=your-dashscope-key-here
# LLM_GRAPH_TEMPERATURE=0.1

# ==================== 跨厂商示例（全部注释，按需启用） ====================
# 场景 1：分析用 OpenAI，视觉+决策用 MiniMax
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxx
# LLM_GRAPH_PROVIDER=minimax_cn
# LLM_GRAPH_BASE_URL=https://api.minimaxi.com/v1
# LLM_GRAPH_MODEL=MiniMax-M3.1-Flash
# LLM_GRAPH_API_KEY=your-minimax-key
#
# 场景 2：分析用 MiniMax，视觉+决策用 Qwen-VL
# LLM_AGENT_PROVIDER=minimax_cn
# LLM_AGENT_MODEL=MiniMax-M3.1-Flash
# LLM_AGENT_API_KEY=your-minimax-key
# LLM_GRAPH_PROVIDER=qwen
# LLM_GRAPH_MODEL=qwen-vl-max-latest
# LLM_GRAPH_API_KEY=your-dashscope-key
#
# 场景 3：两槽位同厂商不同模型
# LLM_AGENT_MODEL=MiniMax-M3.1-Flash
# LLM_GRAPH_MODEL=MiniMax-M3
#
# 场景 4：分析用 DeepSeek（文本），视觉+决策用 Qwen-VL
# DeepSeek 目前只提供文本模型（deepseek-chat / deepseek-reasoner），
# 不支持图片识别，因此 graph 槽位建议单独配置视觉模型。
# LLM_AGENT_PROVIDER=deepseek
# LLM_AGENT_BASE_URL=https://api.deepseek.com/v1
# LLM_AGENT_MODEL=deepseek-chat
# LLM_AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_GRAPH_PROVIDER=qwen
# LLM_GRAPH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_GRAPH_MODEL=qwen-vl-max-latest
# LLM_GRAPH_API_KEY=your-dashscope-key
#
# 场景 5：全部使用 DeepSeek（仅文本，视觉识别能力不可用）
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
